# Copy to .env (git-ignored). All values are optional.
# Folder for the SQLite database; a relative path is resolved against the repo root.
# DATA_DIR=data
# Desktop-app OAuth client JSON downloaded from Google Cloud Console. Never put it in the repo.
# CLIENT_SECRET_PATH=~/.config/youtube-playlist-sorter/client_secret.json
# Stop inserting once this many quota units were used today (the API allows 10000).
# DAILY_QUOTA_BUDGET=8000

# --- Server (web UI and VM) ---
# Where secrets live: "keyring" (the OS keychain, the default for local use) or "systemd"
# (read-only files from LoadCredentialEncrypted=; add them on the VM with systemd-creds encrypt).
# Secret names: refresh-token, login-client-secret, session-key. Never put their values in this file.
# SECRETS_BACKEND=keyring
# Folder of decrypted credentials for the systemd backend; systemd sets it for the service, so leave it unset.
# CREDENTIALS_DIRECTORY=
# Sign-in for the web UI: "google" (Google sign-in) or "tailscale" (Tailscale identity headers only).
# AUTH_MODE=google
# The only Google account allowed to sign in.
# OWNER_EMAIL=you@example.com   (required when AUTH_MODE=google: the one Google account allowed to sign in)
# The only Tailscale login accepted when AUTH_MODE=tailscale; empty means nobody.
# OWNER_TAILSCALE_LOGIN=
# The URL the UI is opened at; sign-in redirects and the Origin check use it.
# PUBLIC_URL=http://127.0.0.1:8765
# Port the server listens on (always on 127.0.0.1).
# BIND_PORT=8765
# A tick may spend quota up to this many units in the Pacific day.
# TICK_QUOTA_CEILING=9500
# Client id of the Web OAuth client used for Google sign-in (its secret goes in the secret store as login-client-secret).
# LOGIN_CLIENT_ID=
# Graph the timer and the Rules editor use; a relative path is resolved against the repo root.
# GRAPH_PATH=graphs/mine.yaml
# Set to true on the laptop once the VM does the real runs; `run` without --dry-run then exits 5.
# REAL_RUNS_DISABLED=false
